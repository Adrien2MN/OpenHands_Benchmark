\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Per-instance duration distributions, split by resolved (green) and unresolved (gray). Resolved instances are consistently faster across all models. Qwen's higher absolute durations reflect deeper exploration per instance (more tool calls, longer conversations), not idle time.}}{4}{figure.caption.10}\protected@file@percent }
\newlabel{fig:duration}{{4}{4}{Per-instance duration distributions, split by resolved (green) and unresolved (gray). Resolved instances are consistently faster across all models. Qwen's higher absolute durations reflect deeper exploration per instance (more tool calls, longer conversations), not idle time}{figure.caption.10}{}}
\newlabel{fig:duration@cref}{{[figure][4][]4}{[1][3][]4}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Tool-call distribution per model. Mistral is file-editor-dominant (68\%), while Qwen and Gemma favor terminal commands (55\% and 49\%, respectively). Higher terminal usage correlates with Qwen's deeper exploration and higher resolve rate.}}{4}{figure.caption.11}\protected@file@percent }
\newlabel{fig:tools}{{5}{4}{Tool-call distribution per model. Mistral is file-editor-dominant (68\%), while Qwen and Gemma favor terminal commands (55\% and 49\%, respectively). Higher terminal usage correlates with Qwen's deeper exploration and higher resolve rate}{figure.caption.11}{}}
