# All-in-one experiment image:
#   vLLM (Qwen) + OpenHands Benchmark + energy measurement
#
# Runs entirely self-contained on a GPU VM.
FROM nvidia/cuda:12.4.1-devel-ubuntu22.04

ENV PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive \
    VLLM_PORT=8000

# System deps + Docker CLI (for SWE-bench Docker workspace)
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3.11 python3.11-venv python3.11-dev python3-pip \
    git wget curl ca-certificates jq \
    docker.io \
    && ln -sf /usr/bin/python3.11 /usr/bin/python \
    && python -m pip install --upgrade pip \
    && rm -rf /var/lib/apt/lists/*

# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

# Install vLLM
RUN pip install --no-cache-dir "vllm>=0.8.0" "huggingface-hub[hf_transfer]"

# Install energy measurement tools
RUN pip install --no-cache-dir codecarbon ecologits

# Model will be downloaded at runtime (ACR build has insufficient RAM for large models)
ARG MODEL_ID=Qwen/Qwen2.5-7B-Instruct
ENV MODEL_ID=${MODEL_ID}
ENV HF_XET_HIGH_PERFORMANCE=1

# Copy benchmark code
WORKDIR /workspace
COPY . /workspace/

# Install benchmark deps
RUN uv sync --dev 2>/dev/null || pip install -e .

# Energy measurement + experiment runner
COPY azure/qwen-serve/run_experiment_inner.sh /run_experiment_inner.sh
RUN chmod +x /run_experiment_inner.sh

ENTRYPOINT ["/run_experiment_inner.sh"]
