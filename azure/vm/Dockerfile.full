FROM nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# System deps: Python 3.12 (via deadsnakes), git, curl, Docker CLI
RUN apt-get update -qq && \
    apt-get install -y -q --no-install-recommends \
        software-properties-common curl ca-certificates gnupg lsb-release && \
    add-apt-repository ppa:deadsnakes/ppa -y && \
    apt-get update -qq && \
    apt-get install -y -q --no-install-recommends \
        python3.12 python3.12-dev \
        git build-essential ninja-build && \
    curl -sS https://bootstrap.pypa.io/get-pip.py | python3.12 && \
    # Docker CLI (daemon comes from host VM socket at runtime)
    install -m 0755 -d /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg \
        | gpg --dearmor -o /etc/apt/keyrings/docker.gpg && \
    chmod a+r /etc/apt/keyrings/docker.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] \
        https://download.docker.com/linux/ubuntu $(lsb_release -cs) stable" \
        > /etc/apt/sources.list.d/docker.list && \
    apt-get update -qq && \
    apt-get install -y -q --no-install-recommends \
        docker-ce-cli docker-buildx-plugin && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Install uv
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Copy repo into image
WORKDIR /app
COPY . /app

ENV SSL_CERT_FILE=/app/azure/vm/axa_combined_ca.pem

# Make inner script executable
RUN chmod +x azure/vm/run_experiment_inner.sh

# Default entrypoint
CMD ["bash", "azure/vm/run_experiment_inner.sh"]